# Voorbeeld voor /etc/marathon.env (rechten 600, eigenaar root).
# Nooit echte waarden in de repo zetten.

# Cloudflare Access (verplicht)
ACCESS_TEAM_DOMAIN=jouwteam.cloudflareaccess.com
ACCESS_AUD=
ALLOWED_EMAIL=

# Token waarmee DRX runs mag toevoegen en lezen (minstens 32 tekens).
# Aanmaken met: openssl rand -hex 32
DRX_API_TOKEN=

# Optioneel
PORT=8788
HOST=127.0.0.1
DATA_DIR=/var/lib/marathon

# Alleen lokaal ontwikkelen, NOOIT op de server:
# DEV_BYPASS_AUTH=1
