# Voorbeeld voor /etc/marathon.env (chmod 600, eigenaar root).
# Kopieer naar de server en vul in. Zet echte waarden NOOIT in de repo.

# Cloudflare Access (verplicht; zonder deze drie weigert de API alles)
ACCESS_TEAM_DOMAIN=jouwteam.cloudflareaccess.com
ACCESS_AUD=
ALLOWED_EMAIL=

# Optioneel: token voor DRX om runs te importeren vanaf de server zelf
# (alleen POST /api/runs en /api/runs/bulk, alleen via http://127.0.0.1:8788).
# Maak er een met: openssl rand -hex 32   (min. 32 tekens)
DRX_API_TOKEN=

# Optioneel (dit zijn de standaardwaarden)
PORT=8788
DATA_DIR=/var/lib/marathon
# TIMEZONE=Europe/Brussels

# NOOIT in productie: DEV_BYPASS_AUTH=1
