{
  "name": "marathon-server",
  "version": "1.0.0",
  "private": true,
  "description": "API voor het marathonschema op carldrx.io (Node 22, Hono, SQLite)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "DEV_BYPASS_AUTH=1 SERVE_STATIC=1 DATA_DIR=./data node --disable-warning=ExperimentalWarning src/index.js",
    "dev:finance": "DEV_BYPASS_AUTH=1 SERVE_STATIC=1 DATA_DIR=./data FINANCE_FILE=./test/fixtures/finance-sample.json node --disable-warning=ExperimentalWarning src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "hono": "^4.6.0"
  }
}
